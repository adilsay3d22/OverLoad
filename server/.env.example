# Point this at your DEVELOPMENT Neon branch, not production.
# Neon dashboard -> Branches -> the dev branch -> Connect -> keep
# "Connection pooling" ON. The host must contain "-pooler".
DATABASE_URL=""

# Signs session tokens. Generate one with:  openssl rand -base64 48
# The server refuses to start in production without it, because a deployed
# build signing sessions with a public constant is not authentication.
OVERLOAD_JWT_SECRET=""

# Lets `npm run db:seed` write its fabricated training history here.
# Set this ONLY in a development branch's .env. Never set it in a deployment:
# it is what stops the fixture reaching a database real people use.
OVERLOAD_ALLOW_SEED=1
