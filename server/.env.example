# Local development. Point DATABASE_URL at the DEV Neon branch, never production.
#
# Neon dashboard -> Branches -> the dev branch -> Connect -> keep
# "Connection pooling" ON -> copy. The host must contain "-pooler".
DATABASE_URL=""

# Signs session tokens. Generate one with:  openssl rand -base64 48
# The same value goes into the deployment, so a token issued locally still
# works against the deployed app. The server refuses to start in production
# without it, because a build signing sessions with a public constant is not
# authentication.
OVERLOAD_JWT_SECRET=""

# ---------------------------------------------------------------------------
# Development only. Uncomment the line below in your local .env — and NEVER
# set it in a deployment.
#
# It is what lets `npm run db:seed` write three weeks of fabricated training
# history. Its absence is the only thing standing between that fixture and a
# database real people use, so it is deliberately left commented here: hosts
# like Vercel read this file to pre-fill their environment-variable form, and
# an uncommented line would get offered as something to set in production.
# ---------------------------------------------------------------------------
# OVERLOAD_ALLOW_SEED=1
